# ---- copy to .env on the VPS and fill in ----
SECRET_KEY=change-this-to-a-long-random-string
PUBLIC_BASE_URL=https://desk.juooa.cloud
COOKIE_SECURE=1

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=IEA

# Coordinator sign-in. ADMIN_EMAIL may be a plain username ("admin") or an
# email address — it is the identifier typed on the sign-in page. Seeded once,
# on first boot; changing it later does not overwrite the existing account.
ADMIN_EMAIL=admin
ADMIN_NAME=Office of Academics
ADMIN_PASSWORD=set-a-real-password

PORT=8130
